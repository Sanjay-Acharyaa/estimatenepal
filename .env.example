# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@localhost:3306/nepali_estimate"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Full public URL of the app (no trailing slash)
NEXTAUTH_URL="https://estimatenepal.com"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
# Must be a verified sender in your Resend account
EMAIL_FROM="Estimate Nepal <noreply@estimatenepal.com>"

# ─── Webhooks ────────────────────────────────────────────────────────────────
# From Resend dashboard → Webhooks → your endpoint → Signing Secret
# Required for delivery event tracking (bounce, complaint detection).
# Without this, the /api/webhooks/resend endpoint rejects all requests.
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_signing_secret"

# ─── Cron ────────────────────────────────────────────────────────────────────
# Arbitrary secret — include in Authorization: Bearer <secret> when calling /api/cron/trial-reminder
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# ─── Redis (rate limiting) ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Storage (optional) ──────────────────────────────────────────────────────
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="ap-south-1"
