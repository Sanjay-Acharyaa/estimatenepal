generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Auth & Organisation
model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String?
  passwordHash   String
  emailVerified      Boolean         @default(false)
  verifyToken        String?         @unique
  verifyTokenAt      DateTime?
  passwordChangedAt  DateTime?
  role               UserRole        @default(MEMBER)
  isSuperAdmin   Boolean         @default(false)
  orgId          String?
  org            Org?            @relation(fields: [orgId], references: [id])
  projectMembers ProjectMember[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  failedLogins   FailedLogin[]
  authoredNotes  ProjectNote[]  @relation("AuthoredNotes")
  assignedTasks  ProjectTask[]  @relation("AssignedTasks")
  createdTasks   ProjectTask[]  @relation("CreatedTasks")
  lastLoginAt    DateTime?
  lastSeenPath     String?
  isTestAccount    Boolean        @default(false)
  referralSource   String?
  referralMedium   String?
  referralCampaign String?
  sessions         UserSession[]
  drawingComments DrawingComment[] @relation("DrawingComments")
  npsSentAt              DateTime?
  npsScore               Int?
  emailUnsubscribedAt    DateTime?
  emailBouncedAt         DateTime?
  procurementRoles          String?
  secondaryPassphraseHash   String?
  bidVerificationDocuments  BidVerificationDocument[]
  notificationPreferences   NotificationPreference[]
  createdAt              DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orgId])
  @@index([email])
  @@index([emailUnsubscribedAt])
  @@index([emailBouncedAt])
}

model Org {
  id               String      @id @default(cuid())
  name             String
  plan             PlanType    @default(FREE)
  planTier         String      @default("TRIAL")
  trialEndsAt      DateTime?
  panNumber        String?
  logoUrl          String?
  address          String?
  phone            String?
  storageUsedBytes BigInt      @default(0)
  adminNotes       String?     @db.Text
  churnReason      String?
  churnReasonAt    DateTime?
  churnFeedback    String?     @db.Text
  churnFeedbackAt  DateTime?
  dataWipedAt      DateTime?
  users                     User[]
  projects                  Project[]
  invites                   OrgInvite[]
  rateBatches               RateBatch[]
  assemblies                Assembly[]
  resources                 OrgResource[]
  rateSettings              OrgRateSettings?
  bidVerificationDocuments  BidVerificationDocument[]
  createdAt                 DateTime    @default(now())
}

// A named collection of rates uploaded together (one per import)
model RateBatch {
  id          String        @id @default(cuid())
  orgId       String
  org         Org           @relation(fields: [orgId], references: [id])
  name        String
  type        RateBatchType @default(CUSTOM)
  itemCount   Int           @default(0)
  fiscalYear  String        @default("")
  createdAt   DateTime      @default(now())
  items       RateItem[]

  @@index([orgId])
  @@index([orgId, type])
}

model OrgInvite {
  id         String    @id @default(cuid())
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id])
  email      String
  role       UserRole  @default(MEMBER)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
  @@index([email])
  @@index([orgId, email])                  // pending-invite deleteMany: orgId + email + acceptedAt=null
}

model FailedLogin {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  ipAddress String
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([userId, createdAt(sort: Desc)]) // security queries: failed attempts per user over time
  @@index([createdAt(sort: Desc)])
}

// Projects
model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?        @db.Text
  clientName     String?
  clientCompany  String?
  bidDueDate     DateTime?
  estimatedValue Float?
  district       String?
  seismicZone    String?
  unitSystem     UnitSystem      @default(METRIC)
  dateFormat     String          @default("AD")
  contingencyPct Float?
  provisionalSum Float?
  vatEnabled     Boolean         @default(true)
  vatRate        Float           @default(13)
  tdsRate        Float           @default(1.5)
  tdsEnabled     Boolean         @default(false)
  status          ProjectStatus   @default(ESTIMATING)
  priority        Priority        @default(MEDIUM)
  squareFootage   Float?
  office          String?
  isPricingLocked Boolean         @default(false)
  dueTime         DateTime?
  projectNumber   String?
  scopeOfWork     String?   @db.Text
  ocrRegions      Json?
  exportConfig    Json?
  orgId           String
  org             Org             @relation(fields: [orgId], references: [id])
  members         ProjectMember[]
  drawings        Drawing[]
  folders         DrawingFolder[]
  disciplines     Discipline[]
  takeoffGroups   TakeoffGroup[]  @relation("ProjectTakeoffGroups")
  boqOverrides    BOQOverride[]
  rateAnalyses    RateAnalysis[]
  shareLinks      ShareLink[]
  notes           ProjectNote[]
  tasks           ProjectTask[]
  quotes            SubcontractorQuote[]
  changeOrders      ChangeOrder[]
  retentionEnabled  Boolean           @default(false)
  retentionPct      Float             @default(5)
  retentionReleases RetentionRelease[]
  estimateOverrides EstimateLineOverride[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([orgId])
  @@index([status])
  @@index([orgId, status])
  @@index([orgId, priority])
  @@index([createdAt(sort: Desc)])
}

model ProjectMember {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  projectRole ProjectRole @default(ESTIMATOR)
  assignedBy  String?
  assignedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model ShareLink {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token          String    @unique
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdBy      String
  viewCount      Int       @default(0)
  clientEmail    String?
  clientName     String?
  approvalStatus String?   // PENDING | APPROVED | REJECTED
  approvalNote   String?   @db.Text
  approvedAt     DateTime?
  purpose        String    @default("proposal") // proposal | view
  createdAt      DateTime  @default(now())

  @@index([projectId])
  @@index([isActive])
  @@index([projectId, isActive])           // project detail load: shareLinks where isActive=true
}

// Drawings
model Drawing {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  pageCount       Int
  fileSizeBytes   Int           @default(0)
  revisionNumber  String?
  parentDrawingId String?
  parentDrawing   Drawing?      @relation("revisions", fields: [parentDrawingId], references: [id])
  revisions       Drawing[]     @relation("revisions")
  isLatest        Boolean       @default(true)
  folderId        String?
  folder          DrawingFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  thumbnailUrl    String?
  sortOrder       Int           @default(0)
  status          DrawingStatus @default(PENDING)
  pages           DrawingPage[]
  createdAt       DateTime      @default(now())

  @@index([projectId])
  @@index([projectId, isLatest])
  @@index([folderId])
  @@index([folderId, sortOrder])
}

model DrawingPage {
  id              String           @id @default(cuid())
  drawingId       String
  drawing         Drawing          @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  pageNumber      Int
  label           String?
  scale           Float?
  scaleUnit       String           @default("ft")
  canvasJson      Json?
  annotationsJson Json?
  hasAnnotations  Boolean          @default(false)
  scaleZones      ScaleZone[]
  takeoffItems    TakeoffItem[]
  comments        DrawingComment[]

  @@index([drawingId])
  @@index([drawingId, pageNumber])
}

model DrawingComment {
  id         String      @id @default(cuid())
  pageId     String
  page       DrawingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  projectId  String
  x          Float
  y          Float
  text       String      @db.Text
  authorId   String
  author     User        @relation("DrawingComments", fields: [authorId], references: [id])
  parentId   String?
  resolvedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([pageId])
  @@index([pageId, parentId])
}

model ScaleZone {
  id        String      @id @default(cuid())
  pageId    String
  page      DrawingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label     String?
  scale     Float
  scaleUnit String
  x         Float
  y         Float
  width     Float
  height    Float

  @@index([pageId])
}

// Disciplines & Groups
model Discipline {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  sortOrder     Int            @default(0)
  isPrimary     Boolean        @default(false)
  progressPct   Float          @default(0)  // 0–100
  groups        TakeoffGroup[]
  createdAt     DateTime       @default(now())

  @@index([projectId])
}

model TakeoffGroup {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation("ProjectTakeoffGroups", fields: [projectId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           TakeoffGroup?  @relation("TakeoffGroupChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children         TakeoffGroup[] @relation("TakeoffGroupChildren")
  disciplineId     String?
  discipline       Discipline?   @relation(fields: [disciplineId], references: [id])
  name             String
  type             TakeoffTool   @default(LINEAR)
  colour           String        @default("#3B82F6")
  lineWidth        Int           @default(2)
  isLocked         Boolean       @default(false)
  isVisible        Boolean       @default(true)
  tag              String?
  multiplier       Float         @default(1)
  additionalParams Json?
  preamble         String?        @db.Text
  sortOrder        Int           @default(0)
  rateItemId       String?
  rateItem         RateItem?     @relation("GroupRateItem", fields: [rateItemId], references: [id], onDelete: SetNull)
  assemblyId       String?
  assembly         Assembly?     @relation("TakeoffGroupAssembly", fields: [assemblyId], references: [id], onDelete: SetNull)
  version          Int           @default(0)
  items            TakeoffItem[]
  estimateOverrides EstimateLineOverride[]

  @@index([projectId])
  @@index([projectId, disciplineId])
  @@index([parentId])
  @@index([disciplineId])
  @@index([rateItemId])
  @@index([assemblyId])
}

// Takeoff Items
model TakeoffItem {
  id           String        @id @default(cuid())
  pageId       String
  page         DrawingPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  groupId      String?
  group        TakeoffGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label        String
  toolType     TakeoffTool
  shapeType    ShapeType?
  isNegative   Boolean       @default(false)
  multiplier   Float         @default(1)
  length       Float?
  breadth      Float?
  height       Float?
  wastagePct   Float         @default(0)
  siteLocation String?
  measuredDate DateTime?
  notes        String?       @db.Text
  rawQuantity  Float         @default(0)
  quantity     Float
  unit         String
  scaleUsed    Float
  version      Int           @default(1)
  sortOrder    Int           @default(0)
  toolData     Json
  isLocked     Boolean       @default(false)
  // rateItemId is a legacy per-item rate field that was never wired up in BOQ/pricing.
  // Rate linkage is done at the group level (TakeoffGroup.rateItemId). This column has
  // no @relation (no FK constraint) and no code reads it. Do not use without adding a
  // proper @relation and migrating existing data.
  rateItemId   String?
  createdAt    DateTime      @default(now())

  @@index([pageId])
  @@index([groupId])
  @@index([pageId, sortOrder])
  @@index([groupId, sortOrder])            // BOQ roll-up queries ordered by group + sortOrder
}

// Drawing Folders (Documents tab)
// Default folders seeded on project creation: General, Architectural, Structural, Civil, MEP
model DrawingFolder {
  id        String          @id @default(cuid())
  projectId String
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int             @default(0)
  parentId  String?
  parent    DrawingFolder?  @relation("FolderChildren", fields: [parentId], references: [id])
  children  DrawingFolder[] @relation("FolderChildren")
  drawings  Drawing[]
  createdAt DateTime        @default(now())

  @@index([projectId])
  @@index([projectId, sortOrder])
  @@index([parentId])
}

// Project Notes — visible to all org members with project access
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("AuthoredNotes", fields: [userId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, createdAt(sort: Desc)])
}

// Project Tasks — optionally assigned to a team member
model ProjectTask {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?   @db.Text
  assignedToId String?
  assignedTo   User?     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("CreatedTasks", fields: [createdById], references: [id])
  dueDate      DateTime?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([projectId])
  @@index([assignedToId])
  @@index([projectId, isCompleted])
  @@index([projectId, createdAt(sort: Desc)])
}

// Rates
model RateItem {
  id            String         @id @default(cuid())
  code          String
  description   String         @db.Text
  unit          String
  baseRate      Float
  fiscalYear    String
  source        RateSource
  isPublished   Boolean        @default(false)
  orgId         String?
  batchId       String?
  batch         RateBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  districtRates  DistrictRate[]
  analyses       RateAnalysis[]
  analysisLines  RateAnalysisLine[]
  overrides      BOQOverride[]
  takeoffGroups  TakeoffGroup[] @relation("GroupRateItem")

  @@unique([orgId, code])                  // prevent duplicate org-rate codes within the same org
  @@index([source])
  @@index([orgId])
  @@index([fiscalYear])
  @@index([batchId])
  @@index([orgId, batchId])               // org rate list filtered by batch
  @@index([code])                          // assembly apply-time resolution by DUDBC code
  @@index([source, fiscalYear])
  @@index([source, isPublished])
  @@index([source, fiscalYear, isPublished])
  @@index([orgId, source])                 // org-scoped rate list filtered by source
}

model DistrictRate {
  id         String   @id @default(cuid())
  rateItemId String
  rateItem   RateItem @relation(fields: [rateItemId], references: [id], onDelete: Cascade)
  district   String
  rate       Float

  @@unique([rateItemId, district])
  @@index([rateItemId])
  @@index([district])
}

model RateAnalysis {
  id                String   @id @default(cuid())
  rateItemId        String
  rateItem          RateItem @relation(fields: [rateItemId], references: [id], onDelete: Cascade)
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialCost      Float    @default(0)
  skilledLabour     Float    @default(0)
  semiSkilledLabour Float    @default(0)
  unskilledLabour   Float    @default(0)
  equipmentCost     Float    @default(0)
  overheadPct       Float    @default(0)
  profitPct         Float    @default(0)
  wastagePct        Float    @default(0)
  computedRate      Float
  useComputedRate   Boolean  @default(false)

  @@unique([projectId, rateItemId])
  @@index([projectId])
  @@index([rateItemId])
}

// Estimating Sheet line overrides (markup, waste, notes per takeoff group)
model EstimateLineOverride {
  id        String       @id @default(cuid())
  orgId     String
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupId   String
  group     TakeoffGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  markupPct Float        @default(0)
  wastePct  Float        @default(0)
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, groupId])
  @@index([projectId])
  @@index([orgId])
  @@index([groupId])
}

// BOQ Overrides
model BOQOverride {
  id            String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rateItemId    String
  rateItem      RateItem       @relation(fields: [rateItemId], references: [id], onDelete: Restrict)
  field         String
  originalValue String
  proposedValue String
  approvedValue String?
  status        OverrideStatus @default(PENDING)
  submittedBy   String
  reviewedBy    String?
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?

  @@index([projectId])
  @@index([projectId, status])
  @@index([rateItemId])
}

// Notifications & Audit
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  link      String?
  meta      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)]) // notification list: userId + ORDER BY createdAt DESC
  @@index([createdAt(sort: Desc)])
}

// Read-only declaration — table owned and written by the Bidding platform
model BidNotificationTemplate {
  id              Int      @id @default(autoincrement())
  eventKey        String   @unique @map("event_key")
  displayName     String   @map("display_name")
  emailSubject    String   @map("email_subject")
  emailBody       String   @db.Text @map("email_body")
  channelPriority String   @default("MEDIUM") @map("channel_priority")
  isDisableable   Boolean  @default(true) @map("is_disableable")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("bid_notification_templates")
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String
  eventKey     String
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id])

  @@unique([userId, eventKey])
  @@index([userId])
  @@map("notification_preferences")
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  event      String
  resourceId String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@index([userId])
  @@index([orgId, createdAt(sort: Desc)])
}

// Assembly Library
model Assembly {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  category    String?         // Structural, Civil, MEP, Architectural, Road, Irrigation
  orgId       String?         // null = platform template (visible to all orgs)
  org         Org?            @relation(fields: [orgId], references: [id])
  isPublic         Boolean          @default(false)
  createdById      String?
  groups           AssemblyGroup[]
  takeoffGroups    TakeoffGroup[]   @relation("TakeoffGroupAssembly")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([orgId])
  @@index([isPublic])
  @@index([category])
}

model AssemblyGroup {
  id               String          @id @default(cuid())
  assemblyId       String
  assembly         Assembly        @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           AssemblyGroup?  @relation("AssemblyGroupChildren", fields: [parentId], references: [id])
  children         AssemblyGroup[] @relation("AssemblyGroupChildren")
  name             String
  type             TakeoffTool     @default(LINEAR)
  colour           String          @default("#3B82F6")
  lineWidth        Int             @default(2)
  additionalParams Json?
  rateCode         String?         // DUDBC rate code — resolved to rateItemId at apply-time
  sortOrder        Int             @default(0)

  @@index([assemblyId])
  @@index([parentId])
}

// Subcontractor Quotes (quote comparison table)
model SubcontractorQuote {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor     String
  amount     Float
  discipline String?
  notes      String?     @db.Text
  status     QuoteStatus @default(RECEIVED)
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([projectId])
  @@index([projectId, status])
}

// Enums
enum DrawingStatus {
  PENDING
  IN_PROGRESS
  COMPLETE
}

enum ChangeOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model ChangeOrder {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  description String?           @db.Text
  reason      String?           @db.Text
  amount      Float             @default(0)
  status      ChangeOrderStatus @default(DRAFT)
  requestedBy String
  approvedBy  String?
  approvedAt  DateTime?
  rejectedAt  DateTime?
  rejectionNote String?         @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([projectId, number])
  @@index([projectId])
  @@index([projectId, status])
}

enum QuoteStatus {
  RECEIVED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model RetentionRelease {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount      Float
  note        String?  @db.Text
  releasedAt  DateTime @default(now())
  createdById String
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([projectId, releasedAt(sort: Desc)])
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
  ACADEMIC
}

enum ProjectStatus {
  ESTIMATING
  BID_SUBMITTED
  ACCEPTED
  IN_PROGRESS
  COMPLETE
  LOST
  ARCHIVED
}

enum ProjectRole {
  LEAD
  ESTIMATOR
  VIEWER
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum TakeoffTool {
  COUNT
  LINEAR
  COUNT_BY_DISTANCE
  AREA
  VOLUME
  VERTICAL_WALL_AREA
}

enum ShapeType {
  RECTANGLE
  POLYLINE
  POLYGON
  CIRCLE
  ARC
}

enum RateSource {
  DUDBC
  DISTRICT
  CUSTOM
}

enum RateBatchType {
  CUSTOM
  DISTRICT
}

enum OverrideStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  category    String?  // Road, Building, Irrigation, etc.
  structure   Json     // { disciplines: [{name, groups:[{name,type,colour,rateCode}]}] }
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([orgId])
}

// Pending payment record created when a user clicks "Notify on WhatsApp" on checkout
model PendingPayment {
  id        String   @id @default(cuid())
  email     String
  planKey   String
  billing   String
  amount    Int
  txnId     String
  orgId     String?
  status    String   @default("PENDING")
  adminNote String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// Dynamic site configuration — editable by superadmin without redeploy
model SiteConfig {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

// User-submitted testimonials — approved by superadmin before appearing on landing page
model Testimonial {
  id          String    @id @default(cuid())
  authorName  String
  authorRole  String?
  company     String?
  content     String    @db.Text
  rating      Int       @default(5)
  isApproved  Boolean   @default(false)
  userId      String?
  submittedAt DateTime  @default(now())
  approvedAt  DateTime?

  @@index([isApproved, submittedAt(sort: Desc)])
}

// Single-use access coupons generated by super admin and sent to customers manually.
// Redeeming a coupon extends the org's trialEndsAt by durationDays.
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  durationDays  Int
  planType      String?   // PRO | ENTERPRISE | null = trial extension only
  planTier      String?   // SOLO | TEAM3 | TEAM5 | ENTERPRISE
  createdById   String
  createdAt     DateTime  @default(now())
  redeemedByOrg String?
  redeemedAt    DateTime?

  @@index([code])
  @@index([redeemedByOrg])
}

// User session tracking — written when a session ends (presence beacon detects new session after gap)
model UserSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  pageCount       Int      @default(0)
  date            DateTime @db.Date

  @@index([userId, startedAt(sort: Desc)])
  @@index([date(sort: Desc)])
  @@index([userId, date])
}

// Email audit log — written after every lifecycle email send
model EmailLog {
  id             String   @id @default(cuid())
  orgId          String?
  recipientEmail String
  recipientName  String
  emailType      String   @db.VarChar(64)
  subject        String
  status         String   @default("sent")  // sent | failed
  errorMessage   String?  @db.Text
  resendEmailId  String?  @db.VarChar(50)
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  sentAt         DateTime @default(now())

  @@index([orgId, sentAt(sort: Desc)])
  @@index([emailType, sentAt(sort: Desc)])
  @@index([sentAt(sort: Desc)])
  @@index([resendEmailId])
}

// Customisable email templates — superadmin edits these in /admin/emails
model EmailTemplate {
  id          String   @id @default(cuid())
  emailType   String   @unique @db.VarChar(64)
  subject     String
  bodyHtml    String   @db.LongText
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([emailType])
}

// Resource Library — org-level catalog of materials, labour and equipment with unit prices.
// Every RateAnalysisLine references a resource from this library.
model OrgResource {
  id             String           @id @default(cuid())
  orgId          String
  org            Org              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String           @db.VarChar(200)
  category       ResourceCategory
  unit           String
  unitRate       Float            @default(0)
  wastagePercent Float            @default(0)
  notes          String?
  isDefault      Boolean          @default(false)
  priceUpdatedAt DateTime?
  analysisLines  RateAnalysisLine[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([orgId, name, category])
  @@index([orgId])
  @@index([orgId, category])
}

// One line in a resource-based rate analysis template (org + rate item level).
// Multiple lines build up the full cost breakdown for a unit of work.
// orgId is a denormalized filter field (no @relation / FK) — used only for index-scoped queries.
// If org isolation or cascade deletes are ever needed here, add a proper Org @relation.
model RateAnalysisLine {
  id             String      @id @default(cuid())
  orgId          String
  rateItemId     String
  rateItem       RateItem    @relation(fields: [rateItemId], references: [id], onDelete: Cascade)
  resourceId     String
  resource       OrgResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  lineType       LineType    @default(MATERIAL)
  qtyPerUnit     Float       @default(0)
  wastagePercent Float       @default(0)
  notes          String?
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([orgId, rateItemId])
  @@index([orgId, resourceId])
  @@index([orgId])
  @@index([resourceId])
}

// Per-org rate calculation settings: overhead, profit, contingency, VAT, and DUDBC dry volume factors.
model OrgRateSettings {
  id                String   @id @default(cuid())
  orgId             String   @unique
  org               Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  overheadPct       Float    @default(12)
  profitPct         Float    @default(10)
  contingencyPct    Float    @default(5)
  vatPct            Float    @default(13)
  leadLiftPct       Float    @default(0)
  dryVolumeMortar   Float    @default(1.30)
  dryVolumeConcrete Float    @default(1.54)
  updatedAt         DateTime @updatedAt
}

enum LineType {
  MATERIAL
  LABOUR
  EQUIPMENT
  OTHER
}

enum ResourceCategory {
  CEMENT
  FINE_AGGREGATE
  COARSE_AGGREGATE
  MASONRY
  STEEL
  TIMBER
  LABOUR_SKILLED
  LABOUR_UNSKILLED
  EQUIPMENT
  OTHER
}

// Snapshot of each template before it is overwritten (version history)
model EmailTemplateVersion {
  id        String   @id @default(cuid())
  emailType String   @db.VarChar(64)
  subject   String
  bodyHtml  String   @db.LongText
  savedAt   DateTime @default(now())
  savedBy   String?

  @@index([emailType, savedAt(sort: Desc)])
}

// Cron run audit log — written after every trial-reminder cron execution
model CronLog {
  id          String   @id @default(cuid())
  runAt       DateTime @default(now())
  durationMs  Int
  totalSent   Int
  totalFailed Int
  sent        Json
  failed      Json
  error       String?  @db.Text

  @@index([runAt(sort: Desc)])
}

// Analytics event log — fire-and-forget, never blocks requests, powers admin analytics dashboard
model AnalyticsEvent {
  id        String   @id @default(cuid())
  orgId     String?
  userId    String?
  event     String   @db.VarChar(100)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt(sort: Desc)])
  @@index([orgId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model BidVerificationDocument {
  id                Int       @id @default(autoincrement())
  userId            String
  orgId             String?
  documentType      String
  fileUrl           String    @db.Text
  fileSizeBytes     BigInt    @default(0)
  status            String    @default("PENDING")
  rejectionReason   String?   @db.Text
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  org               Org?      @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("bid_verification_documents")
}

// ─── Bid Platform Declaration Models (read-only from shared DB) ──────────────

model BidUser {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(191)
  password_hash String   @db.VarChar(255)
  full_name     String   @db.VarChar(191)
  role          String   @db.VarChar(50)
  account_type  String   @default("INDIVIDUAL") @db.VarChar(50)
  status        String   @default("ACTIVE") @db.VarChar(50)
  org_id        Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  tenders        Tender[]
  submissions    BidSubmission[]
  requestsToBid  BidTenderRequestToBid[]
  invitations    BidTenderInvitation[]
  watchlistItems BidTenderWatchlist[]
  qandaQuestions BidQandAQuestion[] @relation("QandAAsker")
  qandaAnswers   BidQandAAnswer[]   @relation("QandAAnswerer")
  portfolioProjects BidPortfolioProject[]
  organization   BidOrganization?   @relation(fields: [org_id], references: [id])
  negotiations        BidNegotiation[]
  negotiationMessages BidNegotiationMessage[]
  contractComments    BidContractComment[]
  contractRevisions   BidContractRevision[]
  snagItems           BidSnagItem[]           @relation("SnagAddedBy")
  completionRequests  BidCompletionRequest[]
  ratingsGiven        BidRating[]             @relation("BidRater")
  ratingsReceived     BidRating[]             @relation("BidRated")

  @@index([org_id])
  @@map("bid_users")
}

model BidPlatformSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique @db.VarChar(100)
  value String @db.Text

  @@map("bid_platform_settings")
}

model Tender {
  id                             Int             @id @default(autoincrement())
  reference_number               String          @unique @db.VarChar(50)
  title                          String          @db.VarChar(300)
  description                    String          @db.Text
  district                       String          @db.VarChar(100)
  location_detail                String?         @db.VarChar(500)
  tender_type                    String          @db.VarChar(50)
  status                         String          @default("DRAFT") @db.VarChar(50)
  bid_deadline                   DateTime
  qanda_deadline                 DateTime?
  estimated_value                Decimal?        @db.Decimal(15, 2)
  site_visit_required            Boolean         @default(false)
  site_visit_scheduled_at        DateTime?
  site_visit_location            String?         @db.VarChar(500)
  quantity_visibility            String          @default("HIDDEN") @db.VarChar(50)
  show_bidder_count              Boolean         @default(false)
  show_estimated_value_on_card   Boolean         @default(false)
  show_client_identity_on_card   Boolean         @default(true)
  bid_security_required          Boolean         @default(false)
  bid_security_percentage        Decimal         @default(0) @db.Decimal(5, 2)
  require_rtb_approval           Boolean         @default(false)
  vat_percentage                 Decimal         @db.Decimal(5, 2)
  contingency_percentage_default Decimal         @db.Decimal(5, 2)
  instructions_to_bidders        String?         @db.Text
  estimation_project_id          String?         @db.VarChar(191)
  awarded_bidder_id              Int?
  awarded_amount_npr             Decimal?        @db.Decimal(15, 2)
  awarded_at                     DateTime?
  client_user_id                 Int
  client_org_id                  Int?
  created_at                     DateTime        @default(now())
  updated_at                     DateTime        @updatedAt
  client                         BidUser                 @relation(fields: [client_user_id], references: [id])
  boqChapters                    BidBoqChapter[]
  submissions                    BidSubmission[]
  requestsToBid                  BidTenderRequestToBid[]
  invitations                    BidTenderInvitation[]
  watchlistItems                 BidTenderWatchlist[]
  qandaQuestions                 BidQandAQuestion[]
  negotiations                   BidNegotiation[]
  loa                            BidLetterOfAward?
  contract                       BidContract?
  snagItems                      BidSnagItem[]
  completionRequests             BidCompletionRequest[]
  ratings                        BidRating[]

  @@index([client_user_id])
  @@index([status])
  @@map("bid_tenders")
}

model BidBoqChapter {
  id                Int           @id @default(autoincrement())
  tender_id         Int
  parent_chapter_id Int?
  title             String        @db.VarChar(300)
  description       String?       @db.Text
  level             Int           @default(1)
  sort_order        Int           @default(0)
  tender            Tender        @relation(fields: [tender_id], references: [id], onDelete: Cascade)
  parent            BidBoqChapter?  @relation("ChapterChildren", fields: [parent_chapter_id], references: [id])
  children          BidBoqChapter[] @relation("ChapterChildren")
  items             BidBoqItem[]

  @@index([tender_id])
  @@index([parent_chapter_id])
  @@map("bid_boq_chapters")
}

model BidBoqItem {
  id              Int           @id @default(autoincrement())
  tender_id       Int
  chapter_id      Int
  item_code       String?       @db.VarChar(191)
  description     String        @db.VarChar(2000)
  unit            String        @db.VarChar(50)
  client_quantity Decimal?      @db.Decimal(15, 4)
  sort_order      Int           @default(0)
  is_alternative  Boolean       @default(false)
  chapter         BidBoqChapter         @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  lineItems       BidSubmissionLineItem[]

  @@index([chapter_id])
  @@index([tender_id])
  @@map("bid_boq_items")
}

model BidSubmission {
  id                     Int                    @id @default(autoincrement())
  tender_id              Int
  bidder_user_id         Int
  status                 String                 @default("DRAFT") @db.VarChar(50)
  version                Int                    @default(1)
  grand_total_npr        Decimal?               @db.Decimal(15, 2)
  vat_amount_npr         Decimal?               @db.Decimal(15, 2)
  contingency_amount_npr Decimal?               @db.Decimal(15, 2)
  contingency_percentage Decimal?               @db.Decimal(5, 2)
  total_with_vat_npr     Decimal?               @db.Decimal(15, 2)
  notes_to_client        String?                @db.Text
  submitted_at           DateTime?
  withdrawn_at           DateTime?
  withdrawal_reason      String?                @db.Text
  withdrawal_count       Int                    @default(0)
  flagged_for_withdrawal Boolean                @default(false)
  price_score            Decimal?               @db.Decimal(5, 2)
  quantity_score         Decimal?               @db.Decimal(5, 2)
  rating_score           Decimal?               @db.Decimal(5, 2)
  verified_score         Decimal?               @db.Decimal(5, 2)
  system_score           Decimal?               @db.Decimal(5, 2)
  outlier_flagged        Boolean                @default(false)
  is_former_consultant   Boolean                @default(false)
  client_note            String?                @db.Text
  manual_rank            Int?
  created_at             DateTime               @default(now())
  updated_at             DateTime               @updatedAt
  tender                 Tender                 @relation(fields: [tender_id], references: [id])
  bidder                 BidUser                @relation(fields: [bidder_user_id], references: [id])
  lineItems              BidSubmissionLineItem[]
  loa                    BidLetterOfAward?      @relation("LoABid")
  contract               BidContract?           @relation("ContractBid")

  @@index([tender_id])
  @@index([bidder_user_id])
  @@map("bid_submissions")
}

model BidSubmissionLineItem {
  id                     Int           @id @default(autoincrement())
  bid_id                 Int
  boq_item_id            Int
  bidder_quantity        Decimal?      @db.Decimal(15, 4)
  bidder_rate_npr        Decimal       @db.Decimal(15, 2)
  amount_npr             Decimal       @db.Decimal(15, 2)
