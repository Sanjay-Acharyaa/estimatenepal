  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  tender             Tender    @relation(fields: [tender_id], references: [id])
  contractor         BidUser   @relation(fields: [contractor_user_id], references: [id])

  @@index([tender_id])
  @@index([contractor_user_id])
  @@map("bid_tender_request_to_bid")
}

model BidTenderInvitation {
  id                 Int       @id @default(autoincrement())
  tender_id          Int
  contractor_user_id Int?
  contractor_email   String    @db.VarChar(255)
  status             String    @default("PENDING") @db.VarChar(50)
  invited_at         DateTime  @default(now())
  responded_at       DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  tender             Tender    @relation(fields: [tender_id], references: [id])
  contractor         BidUser?  @relation(fields: [contractor_user_id], references: [id])

  @@index([tender_id])
  @@index([contractor_user_id])
  @@map("bid_tender_invitations")
}

model BidTenderWatchlist {
  id         Int      @id @default(autoincrement())
  user_id    Int
  tender_id  Int
  created_at DateTime @default(now())
  user       BidUser  @relation(fields: [user_id], references: [id])
  tender     Tender   @relation(fields: [tender_id], references: [id])

  @@unique([user_id, tender_id])
  @@index([user_id])
  @@map("bid_tender_watchlist")
}

model BidQandAQuestion {
  id               Int              @id @default(autoincrement())
