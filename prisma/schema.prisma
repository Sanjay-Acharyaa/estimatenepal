  question            BidQandAQuestion @relation(fields: [question_id], references: [id])
  answeredBy          BidUser          @relation("QandAAnswerer", fields: [answered_by_user_id], references: [id])

  @@index([question_id])
  @@map("bid_qanda_answers")
}

model BidOrganization {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(200)
