model BidContractRevision {
  id                   Int         @id @default(autoincrement())
  contract_id          Int
  revision_number      Int
  content              String      @db.LongText
  submitted_by_user_id Int
  submitted_at         DateTime    @default(now())
  contract             BidContract @relation(fields: [contract_id], references: [id])
  submittedBy          BidUser     @relation(fields: [submitted_by_user_id], references: [id])

  @@index([contract_id])
  @@map("bid_contract_revisions")
}

model BidContractComment {
  id                Int         @id @default(autoincrement())
  contract_id       Int
  clause_reference  String?     @db.VarChar(200)
  comment_text      String      @db.Text
  commenter_user_id Int
  status            String      @default("OPEN") @db.VarChar(50)
  resolved_at       DateTime?
  created_at        DateTime    @default(now())
  contract          BidContract @relation(fields: [contract_id], references: [id])
  commenter         BidUser     @relation(fields: [commenter_user_id], references: [id])

  @@index([contract_id])
  @@map("bid_contract_comments")
}

model BidSnagItem {
  id                 Int      @id @default(autoincrement())
  tender_id          Int
  added_by_user_id   Int
  item_number        Int
  description        String   @db.Text
  location_reference String?  @db.VarChar(300)
  priority           String   @default("MEDIUM") @db.VarChar(50)
  status             String   @default("OPEN") @db.VarChar(50)
  fixed_notes        String?  @db.Text
  rejection_reason   String?  @db.Text
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  tender             Tender   @relation(fields: [tender_id], references: [id])
  addedBy            BidUser  @relation("SnagAddedBy", fields: [added_by_user_id], references: [id])

  @@index([tender_id])
  @@map("bid_snag_items")
}

model BidCompletionRequest {
  id                   Int       @id @default(autoincrement())
  tender_id            Int
  attempt_number       Int       @default(1)
  submitted_by_user_id Int
  completion_notes     String?   @db.Text
  status               String    @default("PENDING") @db.VarChar(50)
  approved_at          DateTime?
  rejected_at          DateTime?
  rejection_reason     String?   @db.Text
  expired_at           DateTime?
  escalated_at         DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  tender               Tender    @relation(fields: [tender_id], references: [id])
  submittedBy          BidUser   @relation(fields: [submitted_by_user_id], references: [id])

  @@index([tender_id])
  @@map("bid_completion_requests")
}

model BidRating {
  id               Int       @id @default(autoincrement())
  tender_id        Int
  rater_user_id    Int
  rated_user_id    Int
  rating_direction String    @db.VarChar(50)
  score_1          Int
  score_2          Int
  score_3          Int
  score_4          Int
  score_5          Int
  average_score    Decimal   @db.Decimal(3, 2)
  review_text      String?   @db.Text
  is_anonymous     Boolean   @default(false)
  submitted_at     DateTime  @default(now())
  window_opened_at DateTime  @default(now())
  window_closes_at DateTime?
  is_visible       Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  tender           Tender    @relation(fields: [tender_id], references: [id])
  rater            BidUser   @relation("BidRater", fields: [rater_user_id], references: [id])
  rated            BidUser   @relation("BidRated", fields: [rated_user_id], references: [id])

  @@unique([tender_id, rater_user_id])
  @@index([tender_id])
  @@map("bid_ratings")
}
