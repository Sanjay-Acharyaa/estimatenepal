  item_notes             String?       @db.Text
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt
  bid                    BidSubmission @relation(fields: [bid_id], references: [id])
  boqItem                BidBoqItem    @relation(fields: [boq_item_id], references: [id])

  @@index([bid_id])
  @@index([boq_item_id])
  @@map("bid_line_items")
}

model BidTenderRequestToBid {
  id                 Int       @id @default(autoincrement())
